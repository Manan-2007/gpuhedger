# ---- GpuHedger frontend configuration ----
# Copy to .env (never commit .env). All values are public — NEVER put private keys here.

# Monad Testnet (default). Use 31337 + http://127.0.0.1:8545 for a local Anvil node.
VITE_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadexplorer.com

# Contract addresses. Optional: if empty, the app reads
# src/contracts/deployments/<chainId>.json written by the deploy script.
VITE_USDC_ADDRESS=
VITE_ORACLE_ADDRESS=
VITE_OPTION_FACTORY_ADDRESS=
VITE_POSITION_NFT_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_FUTURES_ADDRESS=

# Local E2E testing only (chain 31337): auto-connect an Anvil dev account without a browser wallet.
VITE_E2E_MOCK_WALLET=false
